PORT=3000
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Tạo riêng từng secret bằng: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_REFRESH_SECRET=replace_with_another_random_secret_of_at_least_32_bytes

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=realtime-socket-api
JWT_AUDIENCE=realtime-socket-client
