PORT=3000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Khi backend chạy trực tiếp trên máy: localhost.
# Docker Compose sẽ tự ghi đè REDIS_HOST thành tên service "redis" cho container app.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=task_app
# Chỉ dùng chữ và số để tránh lỗi cú pháp ACL/URL; tạo bằng: openssl rand -hex 32
REDIS_PASSWORD=replace_with_a_random_redis_password

# Tạo riêng từng secret bằng: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_REFRESH_SECRET=replace_with_another_random_secret_of_at_least_32_bytes

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_MAX_AGE_MS=604800000
JWT_ISSUER=realtime-socket-api
JWT_AUDIENCE=realtime-socket-client
